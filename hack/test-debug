#!/bin/bash
set -euo pipefail

root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
cd "$root"

workdir=$(mktemp -d /tmp/swarmkit-debug-validation.XXXXXXXX)
server_pid=
cleanup() {
  local status=$?
  trap - EXIT
  if [ -n "$server_pid" ]; then
    kill -TERM -- "-$server_pid" 2>/dev/null || true
    wait "$server_pid" 2>/dev/null || true
  fi
  if [ "$status" -ne 0 ]; then
    for log in "$workdir"/*.log; do
      if [ -f "$log" ]; then
        printf '\n%s\n' "$log" >&2
        cat "$log" >&2
      fi
    done
  fi
  rm -rf -- "$workdir"
  exit "$status"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP

export TMPDIR="$workdir/tmp"
export XDG_CONFIG_HOME="$workdir/config"
export DOCKER_SWARMKIT_DELVE_PORT=0
mkdir -p "$TMPDIR" "$XDG_CONFIG_HOME"
git status --porcelain --untracked-files=all --ignored > "$workdir/before"

setsid ./hack/debug ./identity --listen=127.0.0.1:0 -- -test.run '^TestGenerateGUID$' -test.v > "$workdir/server.log" 2>&1 &
server_pid=$!

deadline=$((SECONDS + 300))
while ! grep -q '^API server listening at:' "$workdir/server.log"; do
  if ! kill -0 "$server_pid" 2>/dev/null || [ "$SECONDS" -ge "$deadline" ]; then
    echo "Delve did not start" >&2
    exit 1
  fi
  sleep 1
done

address=$(sed -n 's/^API server listening at: //p' "$workdir/server.log")
shopt -s nullglob
directories=("$TMPDIR"/swarmkit-debug.*)
test "${#directories[@]}" -eq 1
session_dir=${directories[0]}
test -x "$session_dir/dlv"
test -x "$session_dir/debug.test"

printf '%s\n' 'break github.com/moby/swarmkit/v2/identity.TestGenerateGUID' 'continue' 'continue' 'exit' 'y' |
  timeout 90s "$session_dir/dlv" connect "$address" --allow-non-terminal-interactive > "$workdir/client.log" 2>&1

grep -F '[Breakpoint 1]' "$workdir/client.log"
grep -F 'has exited with status 0' "$workdir/client.log"
grep -F -- '--- PASS: TestGenerateGUID' "$workdir/server.log"

deadline=$((SECONDS + 30))
while kill -0 "$server_pid" 2>/dev/null; do
  if [ "$SECONDS" -ge "$deadline" ]; then
    echo "Delve did not shut down" >&2
    exit 1
  fi
  sleep 1
done
wait "$server_pid"
server_pid=

test ! -e "$session_dir"
git status --porcelain --untracked-files=all --ignored > "$workdir/after"
diff -u "$workdir/before" "$workdir/after"
echo "Delve breakpoint, test execution and temporary artifact cleanup verified."
