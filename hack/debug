#!/bin/bash
set -euo pipefail

if [ "$#" -eq 0 ]; then
  echo "Usage: $0 name/of/go/package [additional dlv test options]" >&2
  exit 1
fi

root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
workdir=$(mktemp -d "${TMPDIR:-/tmp}/swarmkit-debug.XXXXXXXX")
trap 'rm -rf -- "$workdir"' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP
export GOWORK=off GOFLAGS=-mod=readonly GOTOOLCHAIN=local
export GOPROXY=https://proxy.golang.org GOSUMDB=sum.golang.org
export GOPRIVATE="" GONOPROXY=none GONOSUMDB=none GOINSECURE=""
go -C "$root/tools/debug" build -o "$workdir/dlv" github.com/go-delve/delve/cmd/dlv
"$workdir/dlv" test --output="$workdir/debug.test" --accept-multiclient --headless --listen=":${DOCKER_SWARMKIT_DELVE_PORT:-2345}" --api-version=2 --log "$@"
