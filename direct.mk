SHELL := /bin/bash

export GOWORK := off
export GOFLAGS := -mod=readonly
export GOTOOLCHAIN := local
export GOPROXY := https://proxy.golang.org
export GOSUMDB := sum.golang.org
export GOPRIVATE :=
export GONOPROXY := none
export GONOSUMDB := none
export GOINSECURE :=

# Base path used to install.
DESTDIR=/usr/local

# Used to populate version variable in main package.
VERSION=$(shell git describe --match 'v[0-9]*' --dirty='.m' --always)

# Race detector is only supported on amd64.
RACE := $(shell test $$(go env GOARCH) != "amd64" || (echo "-race"))

# Project packages.
PACKAGES = $(shell go list ./...)
INTEGRATION_PACKAGE = $(shell go list ./integration)

# Project binaries.
COMMANDS=swarm-bench swarm-protogen
BINARIES=$(addprefix bin/,$(COMMANDS))
SWARMD_COMMANDS=swarmd swarmctl swarm-rafttool
SWARMD_BINARIES=$(addprefix swarmd/bin/,$(SWARMD_COMMANDS))

VERSIONPKG = $(shell go list ./version)
GO_LDFLAGS=-ldflags "-X $(VERSIONPKG).Version=$(VERSION)"
GO_TESTFLAGS=--timeout=20m $(RACE)

.DEFAULT_GOAL = all
.PHONY: all
all: check binaries test integration-tests swarmd-tests ## run check, build the binaries and run the tests

.PHONY: ci
ci: check binaries checkprotos coverage coverage-integration ## to be used by the CI

.PHONY: AUTHORS
AUTHORS: .mailmap .git/HEAD
	git log --format='%aN <%aE>' | sort -fu > $@

# This only needs to be generated by hand when cutting full releases.
version/version.go:
	./version/version.sh > $@

# Resolve source schemas from the selected Go modules, retaining historical import names.
PROTO_GOGO_DIR = $(shell go list -m -f '{{.Dir}}' github.com/gogo/protobuf)
PROTO_RAFT_DIR = $(shell go list -m -f '{{.Dir}}' go.etcd.io/raft/v3)
PROTO_API = $(addprefix github.com/docker/swarmkit/,$(wildcard api/*.proto))
PROTO_PLUGIN = github.com/docker/swarmkit/protobuf/plugin/plugin.proto
PROTO_DEEPCOPY = github.com/docker/swarmkit/protobuf/plugin/deepcopy/test/deepcopy.proto
PROTO_RAFTPROXY = github.com/docker/swarmkit/protobuf/plugin/raftproxy/test/service.proto
PROTO_GENERATOR = $(ROOTDIR)/bin/swarm-protogen -root "$(ROOTDIR)" -gogo-dir "$(PROTO_GOGO_DIR)" -raft-dir "$(PROTO_RAFT_DIR)"

.PHONY: setup
setup: ## download dependencies through Go Modules
	@go mod download

.PHONY: generate
generate: protos ## regenerate protobuf bindings and API descriptor

.PHONY: protos
protos: setup bin/swarm-protogen ## compile schemas and regenerate Go bindings using Go Modules
	@$(PROTO_GENERATOR) -import-path github.com/moby/swarmkit/v2/api -descriptor api/api.pb.txt $(PROTO_API)
	@$(PROTO_GENERATOR) -import-path github.com/moby/swarmkit/v2/protobuf/plugin $(PROTO_PLUGIN)
	@$(PROTO_GENERATOR) -import-path github.com/moby/swarmkit/v2/protobuf/plugin/deepcopy/test $(PROTO_DEEPCOPY)
	@$(PROTO_GENERATOR) -import-path github.com/moby/swarmkit/v2/protobuf/plugin/raftproxy/test $(PROTO_RAFTPROXY)

.PHONY: checkprotos
checkprotos: generate ## check whether protobuf outputs need regeneration
	@changes=$$(git status --porcelain --untracked-files=all -- '*.pb.go' 'api/api.pb.txt') && \
		if [ -n "$$changes" ]; then \
			printf '%s\n' "$$changes" >&2; \
			git --no-pager diff -- '*.pb.go' 'api/api.pb.txt'; \
			echo "please run 'make generate' when making changes to proto files" >&2; \
			exit 1; \
		fi

.PHONY: check
check: fmt-proto
check: ## Run various source code validation tools
	@echo "🐳 $@"
	@go vet ./...

.PHONY: fmt-proto
fmt-proto:
	@test -z "$$(find . -name '*.proto' -type f -exec grep -Hn -e "^ " {} \; | tee /dev/stderr)" || \
		(echo "👹 please indent proto files with tabs only" && false)
	@test -z "$$(find . -name '*.proto' -type f -exec grep -Hn "Meta meta = " {} \; | grep -v '(gogoproto.nullable) = false' | tee /dev/stderr)" || \
		(echo "👹 meta fields in proto files must have option (gogoproto.nullable) = false" && false)

.PHONY: build
build: ## build the go packages
	@echo "🐳 $@"
	@go build -tags "${DOCKER_BUILDTAGS}" -v ${GO_LDFLAGS} ${GO_GCFLAGS} ${PACKAGES}

.PHONY: test
test: ## run tests, except integration tests
	@echo "🐳 $@"
	@go test -parallel 8 ${GO_TESTFLAGS} -tags "${DOCKER_BUILDTAGS}" $(filter-out ${INTEGRATION_PACKAGE},${PACKAGES})

.PHONY: integration-tests
integration-tests: ## run integration tests
	@echo "🐳 $@"
	@go test -parallel 8 ${GO_TESTFLAGS} -tags "${DOCKER_BUILDTAGS}" ${INTEGRATION_PACKAGE}

.PHONY: swarmd-tests
swarmd-tests: ## run swarmd tests
	@echo "🐳 $@"
	@cd swarmd && go test -parallel 8 ${GO_TESTFLAGS} -tags "${DOCKER_BUILDTAGS}" ./...

# Build a binary from a cmd.
bin/%: cmd/% .FORCE
	@echo "🐳 $@"
	@go build -tags "${DOCKER_BUILDTAGS}" -o $@ ${GO_LDFLAGS}  ${GO_GCFLAGS} ./$<

swarmd/bin/%: swarmd/cmd/% .FORCE
	@echo "🐳 $@"
	@cd swarmd && go build -tags "${DOCKER_BUILDTAGS}" -o ../$@ ${GO_LDFLAGS}  ${GO_GCFLAGS} ../$<

.PHONY: .FORCE
.FORCE:

.PHONY: binaries
binaries: $(BINARIES) $(SWARMD_BINARIES) ## build binaries
	@echo "🐳 $@"

.PHONY: clean
clean: ## clean up binaries
	@echo "🐳 $@"
	@rm -f $(BINARIES) $(SWARMD_BINARIES) bin/dlv

.PHONY: install
install: $(BINARIES) $(SWARMD_BINARIES) ## install binaries
	@echo "🐳 $@"
	@mkdir -p $(DESTDIR)/bin
	@install $(BINARIES) $(SWARMD_BINARIES) $(DESTDIR)/bin

.PHONY: uninstall
uninstall:
	@echo "🐳 $@"
	@rm -f $(addprefix $(DESTDIR)/bin/,$(notdir $(BINARIES)))

.PHONY: coverage
coverage: ## generate coverprofiles from the unit tests
	@echo "🐳 $@"
	@( for pkg in $(filter-out ${INTEGRATION_PACKAGE},${PACKAGES}); do \
		go test ${GO_TESTFLAGS} -tags "${DOCKER_BUILDTAGS}" -test.short -coverprofile="$$(go list -f "{{.Dir}}" $$pkg)/coverage.txt" -covermode=atomic $$pkg || exit; \
	done )

.PHONY: coverage-integration
coverage-integration: ## generate coverprofiles from the integration tests
	@echo "🐳 $@"
	go test ${GO_TESTFLAGS} -tags "${DOCKER_BUILDTAGS}" -test.short -coverprofile="$$(go list -f "{{.Dir}}" ${INTEGRATION_PACKAGE})/coverage.txt" -covermode=atomic ${INTEGRATION_PACKAGE}

.PHONY: help
help: ## this help
	@awk 'BEGIN {FS = ":.*?## "} /^[a-zA-Z_-]+:.*?## / {printf "\033[36m%-30s\033[0m %s\n", $$1, $$2}' $(MAKEFILE_LIST) | sort

.PHONY: module-validate
module-validate: ## verify module integrity and module file consistency
	@tracked_legacy=$$(git ls-files -- ':(glob)**/vendor/**' ':(glob)**/go.work' ':(glob)**/go.work.sum') && test -z "$$tracked_legacy"
	@git ls-files --error-unmatch go.mod go.sum swarmd/go.mod swarmd/go.sum tools/go.mod tools/go.sum tools/debug/go.mod tools/debug/go.sum >/dev/null
	@go mod tidy -diff
	@go mod download
	@go mod verify
	@cd swarmd && go mod tidy -diff && go mod download && go mod verify
	@cd tools && go mod tidy -diff && go mod download && go mod verify
	@cd tools/debug && go mod tidy -diff && go mod download && go mod verify
	@git diff --exit-code HEAD -- go.mod go.sum swarmd/go.mod swarmd/go.sum tools/go.mod tools/go.sum tools/debug/go.mod tools/debug/go.sum
